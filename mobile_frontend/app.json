{
  "expo": {
    "name": "Technest",
    "slug": "technest",
    "version": "1.0.0",
    "scheme": "technest",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111322"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.technest.mobile"
    },
    "android": {
      "package": "com.technest.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111322"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "name": "Technest",
      "backgroundColor": "#F7F7FC"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Technest to select product images for your catalog.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ffcf8d9f-76f3-4182-abda-890022434734"
      }
    }
  }
}
